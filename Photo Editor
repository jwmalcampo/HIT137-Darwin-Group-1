import tkinter as tk
from tkinter import filedialog, messagebox
from tkinter import ttk
from PIL import Image, ImageTk
import cv2
import os

class ImageHandler:
    def __init__(self):
        self.cv_image = None
        self.tk_image = None

    def load_image(self, filepath):
        if not os.path.exists(filepath):
            raise FileNotFoundError("File does not exist.")
        self.cv_image = cv2.imread(filepath)
        if self.cv_image is None:
            raise ValueError("Invalid image format or corrupted image.")
        self.cv_image = cv2.cvtColor(self.cv_image, cv2.COLOR_BGR2RGB)
        pil_image = Image.fromarray(self.cv_image)
        self.tk_image = ImageTk.PhotoImage(pil_image)
        return self.tk_image

class MainApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Image Loader, Cropper & Resizer")
        self.geometry("1200x800")
        self.resizable(False, False)
        self.zoom_scale = 1.0

        self.image_handler = ImageHandler()
        self.start_x = self.start_y = self.rect_id = None
        self.last_cropped_image = None
        self.current_display_image = None

        self._setup_ui()

    def _setup_ui(self):
        self.label = ttk.Label(self, text="No image loaded", font=("Arial", 14))
        self.label.pack(pady=10)

        frame = ttk.Frame(self)
        frame.pack(pady=10)

        self.canvas_frame = ttk.Frame(frame)
        self.canvas_frame.grid(row=0, column=0, padx=10)

        self.canvas = tk.Canvas(self.canvas_frame, width=550, height=500, bg='gray')
        self.canvas.grid(row=0, column=0, sticky="nsew")

        self.h_scroll = ttk.Scrollbar(self.canvas_frame, orient='horizontal', command=self.canvas.xview)
        self.h_scroll.grid(row=1, column=0, sticky='ew')
        self.v_scroll = ttk.Scrollbar(self.canvas_frame, orient='vertical', command=self.canvas.yview)
        self.v_scroll.grid(row=0, column=1, sticky='ns')

        self.canvas.configure(xscrollcommand=self.h_scroll.set, yscrollcommand=self.v_scroll.set)

        self.canvas_cropped = tk.Canvas(frame, width=550, height=500, bg='lightgray')
        self.canvas_cropped.grid(row=0, column=1, padx=10)

        self.load_button = ttk.Button(self, text="Load Image", command=self.load_image)
        self.load_button.pack(pady=5)

        self.save_button = ttk.Button(self, text="Save Cropped Image", command=self.save_image)
        self.save_button.pack(pady=5)

        self.resize_slider = ttk.Scale(self, from_=10, to=300, orient="horizontal", command=self.resize_cropped_image)
        self.resize_slider.set(100)
        self.resize_slider.pack(pady=10)

        zoom_frame = ttk.Frame(self)
        zoom_frame.pack(pady=5)

        zoom_in_button = ttk.Button(zoom_frame, text="Zoom In", command=lambda: self.zoom_image(10))
        zoom_in_button.grid(row=0, column=0, padx=5)

        zoom_out_button = ttk.Button(zoom_frame, text="Zoom Out", command=lambda: self.zoom_image(-10))
        zoom_out_button.grid(row=0, column=1, padx=5)

        self.canvas.bind("<ButtonPress-1>", self.on_mouse_down)
        self.canvas.bind("<B1-Motion>", self.on_mouse_drag)
        self.canvas.bind("<ButtonRelease-1>", self.on_mouse_up)

    def load_image(self):
        file_path = filedialog.askopenfilename(filetypes=[("Image files", "*.jpg *.jpeg *.png *.bmp *.gif")])
        if not file_path:
            return
        try:
            tk_img = self.image_handler.load_image(file_path)
            self.display_image(self.canvas, tk_img)
            self.canvas.image = tk_img
            self.label.config(text=os.path.basename(file_path))
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def display_image(self, canvas, img):
        canvas.delete("all")
        canvas.create_image(0, 0, image=img, anchor=tk.NW)
        canvas.config(scrollregion=canvas.bbox("all"))

    def on_mouse_down(self, event):
        self.start_x = self.canvas.canvasx(event.x)
        self.start_y = self.canvas.canvasy(event.y)
        if self.rect_id:
            self.canvas.delete(self.rect_id)
            self.rect_id = None

    def on_mouse_drag(self, event):
        if self.start_x is not None and self.start_y is not None:
            current_x = self.canvas.canvasx(event.x)
            current_y = self.canvas.canvasy(event.y)
            if self.rect_id:
                self.canvas.delete(self.rect_id)
            self.rect_id = self.canvas.create_rectangle(
                self.start_x, self.start_y, current_x, current_y, outline="red", width=2)

    def on_mouse_up(self, event):
        if self.rect_id:
            self.canvas.delete(self.rect_id)
            self.rect_id = None
        if self.start_x is None or self.start_y is None:
            return

        x1 = self.start_x
        y1 = self.start_y
        x2 = self.canvas.canvasx(event.x)
        y2 = self.canvas.canvasy(event.y)

        ix1, ix2 = sorted([int(x1), int(x2)])
        iy1, iy2 = sorted([int(y1), int(y2)])

        if self.image_handler.cv_image is not None:
            h, w, _ = self.image_handler.cv_image.shape
            ix1, ix2 = max(0, ix1), min(w, ix2)
            iy1, iy2 = max(0, iy1), min(h, iy2)
            if ix2 > ix1 and iy2 > iy1:
                cropped_cv = self.image_handler.cv_image[iy1:iy2, ix1:ix2]
                pil_img = Image.fromarray(cropped_cv)
                self.last_cropped_image = pil_img
                self.current_display_image = pil_img
                tk_img = ImageTk.PhotoImage(pil_img)
                self.display_image(self.canvas_cropped, tk_img)
                self.canvas_cropped.image = tk_img
                self.resize_slider.set(100)
        self.start_x = self.start_y = None

    def resize_cropped_image(self, value):
        if self.last_cropped_image is None:
            return
        try:
            scale_percent = float(value)
            new_width = int(self.last_cropped_image.width * scale_percent / 100)
            new_height = int(self.last_cropped_image.height * scale_percent / 100)
            resized = self.last_cropped_image.resize((new_width, new_height), Image.LANCZOS)
            self.current_display_image = resized
            tk_img = ImageTk.PhotoImage(resized)
            self.display_image(self.canvas_cropped, tk_img)
            self.canvas_cropped.image = tk_img
        except Exception as e:
            messagebox.showerror("Resize Error", str(e))

    def save_image(self):
        if self.current_display_image is None:
            messagebox.showwarning("No Image", "No cropped/resized image to save.")
            return
        file_path = filedialog.asksaveasfilename(
            defaultextension=".png",
            filetypes=[("PNG Image", "*.png"), ("JPEG Image", "*.jpg"), ("All files", "*.*")])
        if file_path:
            try:
                self.current_display_image.save(file_path)
                messagebox.showinfo("Saved", f"Image saved to {file_path}")
            except Exception as e:
                messagebox.showerror("Save Error", str(e))

    def zoom_image(self, delta):
        current_value = self.resize_slider.get()
        new_value = min(max(current_value + delta, 10), 300)
        self.resize_slider.set(new_value)
        self.resize_cropped_image(new_value)

if __name__ == "__main__":
    app = MainApp()
    app.mainloop()
